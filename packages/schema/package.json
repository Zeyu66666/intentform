{
  "name": "@intentform/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FormSchema DSL、语义规则 R1-R8、KaTeX 校验、JSON Patch 应用器（前后端共享）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "katex": "0.16.11",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.8"
  }
}
