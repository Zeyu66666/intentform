{
  "name": "@intentform/llm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAI 兼容协议适配层：手写 SSE 读取、NDJSON LineSplitter、live/record/replay/mock 四模式",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
