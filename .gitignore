# ---- 依赖与构建产物 ----
node_modules/
.pnpm-store/
dist/
build/
out/
coverage/
*.tsbuildinfo
.vite/
.turbo/

# ---- 本地环境与数据（永不入库）----
.env
.env.*
!.env.example
data/
*.db
*.db-journal
# SQLite 的 WAL 模式会额外生成这两个文件；哪怕现在没开 WAL，也不该让它们有机会进库。
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
fixtures/replays/*.tmp

# ---- 编辑器与系统 ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
logs/
tmp/
.tmp/
pnpm-debug.log*

# ---- 个人敏感物（评审要求：姓名/手机号/学校名不得入库）----
个人资料/
*.pem
*.p12
*.jks

# 评测产物：每次运行的报告与原始事件流（体积大，可重跑生成）
eval/runs/
