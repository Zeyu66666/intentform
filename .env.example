# =====================================================================
# 意卷 IntentForm · 环境变量模板
# 用法：cp .env.example .env  然后按需填写。.env 永远不进仓库。
# 默认 LLM_MODE=replay：评委没有 API Key 也能跑通完整闭环。
# 本文件的每一项都在 docs/tech-doc 第 4 章「可复现性」里有对应说明，
# 只有这里列出的变量才会被服务端读取（多一个都不读，避免隐式配置）。
# =====================================================================

# ---- 运行模式 ----
# live   : 实时调用上游模型
# record : 实时调用并录制 NDJSON 回放文件（只有这个模式会写 fixtures/replays）
# replay : 只读回放文件，零外部调用（默认，CI 与评委复现都用它）
# mock   : 不落盘，用内置确定性输出，用于单测
LLM_MODE=replay
PORT=8787
# 前端开发服务器地址，用于 CORS 与 cookie 域判断（生产同源部署时留空）
APP_ORIGIN=http://127.0.0.1:5173

# ---- 回放节奏（计划 v1.1 §3.7）----
# 1x：按录制时的真实节奏播放，视频录制用这个
# 2x：加速
# instant：立刻吐完，CI 与 `pnpm verify` 用这个
LLM_REPLAY_SPEED=instant

# ---- 上游模型（OpenAI 兼容协议；仅 live / record 需要 Key）----
LLM_BASE_URL=https://api.deepseek.com/v1
# 只填在服务端，前端零 Key；留空时 live/record 会在启动期直接报错
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
# 用于思考可视化的推理模型（带 reasoning_content）
LLM_REASONING_MODEL=deepseek-reasoner
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
# 确定性：生成链路固定 temperature=0。
# 注意：推理模型通常忽略 temperature 与 seed，确定性的保证是 record/replay，不是采样参数。
LLM_TEMPERATURE=0
# 上游支持固定 seed 时填写，不支持则留空
LLM_SEED=

# ---- 存储 ----
DATABASE_PATH=./data/intentform.db

# ---- 生产同源托管 ----
# 留空时 `/` 与 `/f/:slug` 的 HTML 请求一律回 404 JSON（本地开发走 vite 5173，不需要这项）。
# 部署时指向构建产物入口，例如 ./web/dist/index.html；路径不存在会在启动日志里报出来，
# 而不是等学生扫码才发现白屏。
WEB_INDEX_HTML=

# ---- 鉴权 ----
# 32 字节以上随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=72
# 哈希用 @node-rs/argon2（预编译二进制，免 node-gyp；备选 crypto.scrypt）。
# 内存成本单位 KiB，64 MiB 是 OWASP 的推荐下限之一，调低会削弱抗暴力破解。
ARGON2_MEMORY_KIB=65536
# session cookie 的 Secure 标志：本地 http://localhost 下必须为 false，否则登录会失效；
# 只有 HTTPS 部署（省赛演示机、正式站点）才设为 true。
COOKIE_SECURE=false

# ---- 限流与预算（计划 §5 安全清单）----
RATE_GENERATE_PER_MIN=10
# 提交限流按「IP × 表单」计
RATE_SUBMIT_PER_MIN=30
# 每日 token 上限，超限时生成接口返回 429 而不是烧钱
DAILY_TOKEN_BUDGET=2000000

# ---- 输入上限（与 packages/schema 的 LIMITS 同源，改这里要同步改常量）----
REQUIREMENT_MAX_CHARS=4000
SUBMISSION_MAX_KB=64
FIELDS_MAX=100

# ---- 评测（I6 起）----
EVAL_REPORT_DIR=./eval/reports
