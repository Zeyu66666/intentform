{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-empty": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-await-in-loop": "off",
    "no-unused-vars": "error"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "fixtures/**",
    "pnpm-lock.yaml"
  ]
}
