{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-empty": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-await-in-loop": "off",
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": ["web/**/*.ts", "web/**/*.tsx"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/jsx-uses-react": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "fixtures/**",
    "pnpm-lock.yaml",
    "web/dist"
  ]
}
